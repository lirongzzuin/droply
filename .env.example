# ─────────────────────────────────────────────────────────────
# DROPLY 환경변수 — 전부 비워두면 mock/개발 모드로 즉시 구동된다.
# 운영 단순화 원칙: 외부 서비스 키가 없어도 앱이 그대로 돌아간다.
# ─────────────────────────────────────────────────────────────

# 앱 URL (OAuth 콜백/OG 이미지 절대경로용)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── DB: Neon (PostgreSQL 서버리스) ──
# 미설정 시 lib/data가 mock 데이터로 폴백한다.
DATABASE_URL=""

# ── 인증: NextAuth ──
# AUTH_SECRET 미설정 시 개발용 시크릿으로 폴백한다 (운영에선 반드시 설정).
AUTH_SECRET=""
# 소셜 키 미설정 시 해당 provider 버튼은 숨고, 개발용 로그인만 노출된다.
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# ── Redis: Upstash (캐시/분산락/레이트리밋/큐) ──
# 미설정 시 in-memory 폴백 (단일 인스턴스 한정).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# 비동기 작업 큐 (경매 마감/알림/정산)
QSTASH_TOKEN=""

# ── 객체 스토리지: Cloudflare R2 (egress 무료) ──
# 미설정 시 로컬/외부 URL 입력 방식으로 폴백.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""

# ── 결제: PortOne(포트원) V2 ──
# 신청 채널: 카드=KG이니시스 / 간편결제=카카오페이 / 가상계좌=한국결제네트웍스 / 본인인증=다날
# 콘솔(admin.portone.io) → 결제연동에서 Store ID, 각 채널키, API Secret 발급
NEXT_PUBLIC_PORTONE_STORE_ID=""              # store-xxxxxxxx
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_CARD=""      # KG이니시스(카드) 채널키
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_EASYPAY=""   # 카카오페이 채널키
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_VBANK=""     # 한국결제네트웍스(가상계좌) 채널키
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_IDENTITY=""  # 다날(본인인증) 채널키
PORTONE_API_SECRET=""                        # 서버 결제 검증용 (절대 NEXT_PUBLIC 아님)
PORTONE_WEBHOOK_SECRET=""                    # (선택) 웹훅 서명 검증

# (구) 토스페이먼츠 직접연동 — PortOne 사용 시 불필요
TOSS_SECRET_KEY=""
NEXT_PUBLIC_TOSS_CLIENT_KEY=""

# ── 알림: Resend (이메일) ──
RESEND_API_KEY=""

# ── 사기조회: 더치트(thecheat) (Phase 5) ──
# 미설정 시 자체 신고 DB 기반 mock 어댑터로 동작.
THECHEAT_API_KEY=""

# ── 플랫폼 정책 ──
# 정가·경매 수수료율(%) / 직거래는 항상 0%
PLATFORM_FEE_PERCENT="8"

# ── Web Push (PWA 푸시) ──
# web-push로 VAPID 키쌍 생성: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ── 사업자 정보 (전자상거래법 표시 의무 / 푸터·약관에 노출) ──
# 미설정 시 "(등록 예정)"으로 표기됨
NEXT_PUBLIC_BIZ_NAME=""              # 상호
NEXT_PUBLIC_BIZ_OWNER=""             # 대표자명
NEXT_PUBLIC_BIZ_REG_NO=""            # 사업자등록번호
NEXT_PUBLIC_BIZ_MAILORDER_NO=""      # 통신판매업신고번호
NEXT_PUBLIC_BIZ_ADDRESS=""           # 사업장 주소
NEXT_PUBLIC_BIZ_TEL=""               # 고객센터 전화
NEXT_PUBLIC_BIZ_EMAIL=""             # 고객센터 이메일
NEXT_PUBLIC_BIZ_HOST="Vercel Inc."   # 호스팅 제공자
